{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ORCH}}",
  "default_agent": "maestro",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "{{LOCAL_NAME}}": {
          "name": "{{LOCAL_NAME}}",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.11.0","--isolated"
      ],
      "enabled": true
    }
  }
}