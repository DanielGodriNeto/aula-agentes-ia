{
  "$schema": "https://opencode.ai/config.json",
  "model": "{{ORCH}}",
  "default_agent": "maestro",
  "subagent_depth": 2,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": "{{LOCAL_MODELS}}"
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--isolated"
      ],
      "enabled": true
    }
  }
}
